{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Toque robot",
        "description": "Robot address (Settings > Advanced > Home Assistant in Toque) and the token shown on its screen.",
        "data": {
          "host": "Host",
          "port": "Port",
          "token": "Token"
        },
        "data_description": {
          "token": "Access token shown on the robot's screen."
        }
      },
      "discovery_confirm": {
        "title": "Toque robot discovered",
        "description": "Toque \"{name}\" was found at {host}. Enter the token shown on the robot's screen.",
        "data": {
          "token": "Token"
        },
        "data_description": {
          "token": "Access token shown on the robot's screen."
        }
      },
      "reauth_confirm": {
        "title": "Token rejected",
        "description": "The robot ({host}) rejected the token. Enter the current token shown on its screen.",
        "data": {
          "token": "Token"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the robot. Check the address, the port and that the API is enabled in Toque.",
      "invalid_auth": "Token rejected.",
      "unsupported_api": "This robot uses an API version this integration does not support."
    },
    "abort": {
      "already_configured": "This robot is already configured.",
      "cannot_connect": "Cannot reach the robot. Check the address, the port and that the API is enabled in Toque.",
      "unsupported_api": "This robot uses an API version this integration does not support.",
      "reauth_successful": "Token updated."
    }
