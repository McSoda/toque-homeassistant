  "services": {
    "list_recipes": {
      "name": "List recipes",
      "description": "Returns the robot's recipe summaries.",
      "fields": {
        "config_entry_id": {
          "name": "Robot",
          "description": "Config entry (optional if there is only one robot)."
        },
        "query": {
          "name": "Search",
          "description": "Text to search for."
        },
        "category": {
          "name": "Category",
          "description": "Filter by category."
        },
        "favorite": {
          "name": "Favorites",
          "description": "Favorites only."
        },
        "limit": {
          "name": "Limit",
          "description": "Maximum number of recipes."
        },
        "offset": {
          "name": "Offset",
          "description": "Number of recipes to skip."
        }
      }
    },
    "get_recipe": {
      "name": "Get recipe",
      "description": "Returns the details of a recipe.",
      "fields": {
        "config_entry_id": {
          "name": "Robot",
          "description": "Config entry (optional if there is only one robot)."
        },
        "recipe_id": {
          "name": "Recipe ID",
          "description": "Recipe identifier (e.g. veloute-de-potiron)."
        }
      }
    },
    "add_recipe_to_todo": {
      "name": "Add ingredients to a list",
      "description": "Adds a recipe's ingredients to a shopping list.",
      "fields": {
        "config_entry_id": {
          "name": "Robot",
          "description": "Config entry (optional if there is only one robot)."
        },
        "recipe_id": {
          "name": "Recipe ID",
          "description": "Recipe identifier (e.g. veloute-de-potiron)."
        },
        "todo_entity_id": {
          "name": "List",
          "description": "Todo entity that receives the ingredients."
        }
      }
    }
  }
